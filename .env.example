# 本地隔离演示环境。不要填写生产地址、真实个人信息或提交本地密码。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=elderly_care_demo
DB_USERNAME=elderly_app
DB_PASSWORD=

# 相对仓库根目录；本地上传和运行数据不会提交到 Git。
APP_STORAGE_ROOT=.local-data/files

# Required for persistent authentication rate-limit HMAC keys. Generate at least 32 random UTF-8 bytes; keep the local value private.
AUTH_RATE_LIMIT_HMAC_KEY=
# Keep true for shared/demo/production use. Local plain-HTTP loopback development may explicitly set false in .env.local only.
AUTH_COOKIE_SECURE=true
# Phone registration and verification stay unavailable until a trusted SMS provider is configured.
PHONE_VERIFICATION_ENABLED=false
